.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx;
  background: linear-gradient(180deg, #ecf8f4 0%, #f7fafc 48%, #fff7ef 100%);
}

.login-visual {
  position: relative;
  overflow: hidden;
  height: 320rpx;
  border-radius: 16rpx;
  box-shadow: 0 18rpx 42rpx rgba(35, 73, 69, 0.1);
}

.login-hero-image {
  width: 100%;
  height: 100%;
}

.login-card {
  margin-top: -18rpx;
}
